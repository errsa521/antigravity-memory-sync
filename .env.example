# OpenAI-compatible API endpoint (中转站地址，带不带 /v1 都可以)
API_BASE_URL=https://your-relay-domain.com/v1
API_KEY=sk-your-api-key-here
API_MODEL=gemini-2.5-flash

# 工作区与噪音过滤（留空 WORKSPACE_FILTER 表示全量；填入路径或目录名如 E:/MyProject 则仅同步该工作区，防跨区串台）
# WORKSPACE_FILTER=
# SKIP_SUBAGENTS=true
# REDACT_SECRETS=true

# 可选：自定义对话角色称呼与 Basic Memory 关联主笔记名
# USER_LABEL=User
# ASSISTANT_LABEL=Assistant
# PROFILE_NOTE_LINK=

# 可选：自定义提示词目录（在目录下放 today.md / daily.md / longterm.md 即可覆盖内置反流水账 Prompt）
# PROMPT_DIR=

# 可选：自定义路径与滚动窗口参数（默认对标 HanaAgent：6 天 + 2500 字上限）
# AGY_BRAIN_DIR=
# AGY_CONVERSATIONS_DIR=
# BASIC_MEMORY_DIR=
# RETENTION_DAYS=6
# WEEK_MAX_CHARS=2500
# MAX_MSG_CHARS=1600
# API_TIMEOUT=90

# 可选：新会话热记忆自动预热（带 trigger: always_on frontmatter；若要按项目隔离可指向 <项目>/.agents/rules/agy-hot-memory.md）
# HOT_MEMORY_ENABLED=true
# HOT_MEMORY_MAX_CHARS=1800
# HOT_LONGTERM_RESERVE=500
# HOT_TODAY_RESERVE=600
# HOT_WEEK_DAYS=3
# HOT_MEMORY_PATH=
