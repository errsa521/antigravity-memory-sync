# OpenAI-compatible API endpoint (中转站地址，带不带 /v1 都可以)
API_BASE_URL=https://your-relay-domain.com/v1
API_KEY=sk-your-api-key-here
API_MODEL=gemini-2.5-flash

# 可选：自定义对话角色称呼与 Basic Memory 关联主笔记名
# USER_LABEL=User
# ASSISTANT_LABEL=Assistant
# PROFILE_NOTE_LINK=

# 可选：自定义路径与滚动窗口参数（默认对标 HanaAgent：6 天 + 2500 字上限）
# AGY_BRAIN_DIR=
# BASIC_MEMORY_DIR=
# RETENTION_DAYS=6
# WEEK_MAX_CHARS=2500
# API_TIMEOUT=90

# 可选：新会话热记忆自动预热（自动写入 ~/.gemini/config/rules/agy-hot-memory.md）
# HOT_MEMORY_ENABLED=true
# HOT_MEMORY_MAX_CHARS=1500
# HOT_WEEK_DAYS=3
# HOT_MEMORY_PATH=
